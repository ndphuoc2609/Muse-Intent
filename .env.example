# Copy thành .env — KHÔNG ghi key thật vào repo, không commit .env.
# DB: SQLite local mặc định. Postgres/Neon:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=sqlite:///./persona-dialogue.db
# LLM: fake (offline, mặc định) | openrouter
LLM_PROVIDER=fake
# Khi dùng OpenRouter + Luna: đặt key qua env của máy chủ, không dán vào chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
MAX_TOOL_ROUNDS=6
MAX_VALIDATOR_REPAIRS=2
MAX_LLM_CALLS_PER_TURN=10
MAX_COST_USD_PER_TURN=0.50
MAX_STORIES_PER_TURN=2
MAX_STORIES_PER_DAY_PER_PERSONA=20
# Lời minh bạch khi khách hỏi trực tiếp có phải AI không:
AI_DISCLOSURE=Mình là persona hư cấu do hệ thống tạo ra để chia sẻ trải nghiệm, không phải người thật.
